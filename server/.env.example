# এই ফাইলটা কপি করে `.env` নাম দিন এবং আসল মান বসান। `.env` কখনো GitHub এ দেবেন না।

PORT=5000
NODE_ENV=development

# MongoDB Atlas এর কানেকশন স্ট্রিং
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tajweed?retryWrites=true&w=majority

# লম্বা, এলোমেলো একটা গোপন লেখা (কমপক্ষে ৩২ অক্ষর)
JWT_SECRET=change-this-to-a-long-random-secret-string

# কোন কোন ওয়েবসাইট এই API ব্যবহার করতে পারবে (কমা দিয়ে আলাদা করুন)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# প্রথম এডমিন (শুধু `npm run seed` চালানোর সময় লাগে)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ekta-shokto-password-din

# Cloudinary (ছবি আপলোডের জন্য) — cloudinary.com এ ফ্রি একাউন্ট
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
